# Copy this file to .env. Keep .env private and never commit API keys.
# Optional: enables OpenAI-generated itineraries and natural-language edits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional live data via OpenStreetMap / OSRM / Open-Meteo. External services
# may have usage policies, rate limits, and availability constraints.
LIVE_DATA_ENABLED=false
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_URL=https://router.project-osrm.org/route/v1/driving
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_USER_AGENT=RoamlyJourneyPlanner/1.0 (local demo)

# Optional local server settings
PORT=5000
FLASK_DEBUG=false
